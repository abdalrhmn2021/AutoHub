PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/autohub?retryWrites=true&w=majority
JWT_SECRET=<a-long-random-hex-string>
JWT_EXPIRES_IN=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# المساعد الذكي (/api/assistant/chat) — بدونه المسار بيرجع 503 برسالة واضحة
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4o-mini

# الدفع الإلكتروني (عربون حجز السيارة + فواتير الصيانة عبر Stripe Checkout)
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-signing-secret>
STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>
